<Slide style={{ padding: 60, background: '#FFFFFF' }}>
    <Box style={{ height: 600 }}>
        <Box style={{ height: 20, flexDirection: 'row', justifyContent: 'space-between', alignItems: 'center' }}>
            <Text style={{ fontSize: 14, color: '#94A3B8', letterSpacing: 2 }}>执行摘要 · OVERVIEW</Text>
            <Box style={{ width: 44, height: 4, borderRadius: 2, background: '#2563EB' }} />
        </Box>
        <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#1E293B', marginTop: 16, lineHeight: 1.2 }}>
            一页看懂：把 AI 从「问答工具」变成「能干活的数字员工」
        </Text>
        <Box style={{ height: 1, background: '#E2E8F0', marginTop: 16 }} />

        <Box style={{ flex: 1, marginTop: 20, flexDirection: 'row', gap: 28 }}>
            {/* 左：定位宣言 */}
            <Box style={{ width: 440 }}>
                <Box style={{ background: '#F4F6FB', borderRadius: 12, padding: 24 }}>
                    <Text style={{ fontSize: 22, fontWeight: '600', color: '#1E293B', lineHeight: 1.3 }}>
                        云顶数字工作台是企业自有的数字员工工作台
                    </Text>
                    <Text style={{ fontSize: 18, color: '#475569', lineHeight: 1.5, marginTop: 14 }}>
                        私有化部署在自己的机器上，让 AI 读懂公司知识、真的动手做事，并且每一步都可控可查。
                    </Text>
                    <Box style={{ height: 1, background: '#E2E8F0', marginTop: 16 }} />
                    <Box style={{ marginTop: 14, gap: 8 }}>
                        <Box style={{ height: 42, borderRadius: 8, background: '#E8EEFB', justifyContent: 'center', paddingLeft: 14 }}>
                            <Text style={{ fontSize: 18, fontWeight: 'bold', color: '#2563EB' }}>33 个岗位专家</Text>
                        </Box>
                        <Box style={{ height: 42, borderRadius: 8, background: '#E8EEFB', justifyContent: 'center', paddingLeft: 14 }}>
                            <Text style={{ fontSize: 18, fontWeight: 'bold', color: '#2563EB' }}>10 个聊天入口</Text>
                        </Box>
                        <Box style={{ height: 42, borderRadius: 8, background: '#FFF7E9', justifyContent: 'center', paddingLeft: 14 }}>
                            <Text style={{ fontSize: 18, fontWeight: 'bold', color: '#B45309' }}>47 个系统连接</Text>
                        </Box>
                    </Box>
                </Box>
            </Box>

            {/* 右：三个业务价值 */}
            <Box style={{ flex: 1, gap: 10 }}>
                <Box style={{ height: 120, flexDirection: 'row', background: '#FFFFFF', borderWidth: 1, borderColor: '#C7D6F5', borderStyle: 'solid', borderRadius: 12, padding: 16 }}>
                    <Box style={{ width: 52, height: 52, borderRadius: 26, background: '#2563EB', justifyContent: 'center', alignItems: 'center' }}>
                        <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#FFFFFF' }}>省</Text>
                    </Box>
                    <Box style={{ flex: 1, marginLeft: 14 }}>
                        <Text style={{ fontSize: 22, fontWeight: '600', color: '#1E293B', lineHeight: 1.3 }}>重复工作自动化，人力用在刀刃上</Text>
                        <Text style={{ fontSize: 18, color: '#475569', lineHeight: 1.5, marginTop: 4 }}>日报周报、数据汇总、批量填报这类「该做但没人爱做」的事，交给定时任务到点自动完成。</Text>
                    </Box>
                </Box>
                <Box style={{ height: 120, flexDirection: 'row', background: '#FFFFFF', borderWidth: 1, borderColor: '#C7D6F5', borderStyle: 'solid', borderRadius: 12, padding: 16 }}>
                    <Box style={{ width: 52, height: 52, borderRadius: 26, background: '#0891B2', justifyContent: 'center', alignItems: 'center' }}>
                        <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#FFFFFF' }}>快</Text>
                    </Box>
                    <Box style={{ flex: 1, marginLeft: 14 }}>
                        <Text style={{ fontSize: 22, fontWeight: '600', color: '#1E293B', lineHeight: 1.3 }}>知识随问随答，答案带得出出处</Text>
                        <Text style={{ fontSize: 18, color: '#475569', lineHeight: 1.5, marginTop: 4 }}>制度、合同、案例入库后随时提问，回答可回溯到原文，新人也能给出统一口径。</Text>
                    </Box>
                </Box>
                <Box style={{ height: 120, flexDirection: 'row', background: '#FFFFFF', borderWidth: 1, borderColor: '#C7D6F5', borderStyle: 'solid', borderRadius: 12, padding: 16 }}>
                    <Box style={{ width: 52, height: 52, borderRadius: 26, background: '#F59E0B', justifyContent: 'center', alignItems: 'center' }}>
                        <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#FFFFFF' }}>稳</Text>
                    </Box>
                    <Box style={{ flex: 1, marginLeft: 14 }}>
                        <Text style={{ fontSize: 22, fontWeight: '600', color: '#1E293B', lineHeight: 1.3 }}>数据不出内网，动作先过审批</Text>
                        <Text style={{ fontSize: 18, color: '#475569', lineHeight: 1.5, marginTop: 4 }}>系统部署在自己机器上，越界动作由人拍板，全过程留痕可回放，合规拿得出证据。</Text>
                    </Box>
                </Box>
            </Box>
        </Box>

        {/* 行动建议条 */}
        <Box style={{ height: 88, background: '#FFF7E9', borderRadius: 10, padding: 14, marginTop: 12 }}>
            <Text style={{ fontSize: 19, fontWeight: '600', color: '#B45309', lineHeight: 1.3 }}>行动建议</Text>
            <Text style={{ fontSize: 18, color: '#7C2D12', lineHeight: 1.5, marginTop: 4 }}>
                从 1 个真实业务场景开始，用 30 天试点验证效果，再决定是否扩大到全公司。
            </Text>
        </Box>
    </Box>
</Slide>
