<Slide style={{ padding: 60, background: '#FFFFFF' }}>
    <Box style={{ height: 600 }}>
        <Box style={{ height: 20, flexDirection: 'row', justifyContent: 'space-between', alignItems: 'center' }}>
            <Text style={{ fontSize: 14, color: '#94A3B8', letterSpacing: 2 }}>02 · 业务怎么用</Text>
            <Box style={{ width: 44, height: 4, borderRadius: 2, background: '#2563EB' }} />
        </Box>
        <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#1E293B', marginTop: 16, lineHeight: 1.2 }}>
            员工零学习成本：在天天用的聊天框里派活
        </Text>
        <Box style={{ height: 1, background: '#E2E8F0', marginTop: 16 }} />

        <Box style={{ flex: 1, marginTop: 20, flexDirection: 'row', gap: 32 }}>
            {/* 左：入口面板 */}
            <Box style={{ width: 420, background: '#F4F6FB', borderRadius: 12, padding: 22 }}>
                <Text style={{ fontSize: 22, fontWeight: '600', color: '#1E293B', lineHeight: 1.3 }}>10 个入口，覆盖主流协作平台</Text>
                <Text style={{ fontSize: 18, color: '#475569', lineHeight: 1.5, marginTop: 8 }}>
                    员工在熟悉的聊天工具里直接派活，不必学新系统、不必改习惯。
                </Text>
                <Box style={{ height: 1, background: '#E2E8F0', marginTop: 14 }} />
                <Box style={{ flexDirection: 'row', gap: 8, marginTop: 14 }}>
                    <Box style={{ background: '#E8EEFB', borderRadius: 8, padding: 10 }}><Text style={{ fontSize: 18, color: '#1E293B' }}>飞书</Text></Box>
                    <Box style={{ background: '#E8EEFB', borderRadius: 8, padding: 10 }}><Text style={{ fontSize: 18, color: '#1E293B' }}>钉钉</Text></Box>
                    <Box style={{ background: '#E8EEFB', borderRadius: 8, padding: 10 }}><Text style={{ fontSize: 18, color: '#1E293B' }}>企业微信</Text></Box>
                    <Box style={{ background: '#E8EEFB', borderRadius: 8, padding: 10 }}><Text style={{ fontSize: 18, color: '#1E293B' }}>微信</Text></Box>
                </Box>
                <Box style={{ flexDirection: 'row', gap: 8, marginTop: 8 }}>
                    <Box style={{ background: '#E8EEFB', borderRadius: 8, padding: 10 }}><Text style={{ fontSize: 18, color: '#1E293B' }}>QQ</Text></Box>
                    <Box style={{ background: '#E8EEFB', borderRadius: 8, padding: 10 }}><Text style={{ fontSize: 18, color: '#1E293B' }}>腾讯元宝</Text></Box>
                    <Box style={{ background: '#E8EEFB', borderRadius: 8, padding: 10 }}><Text style={{ fontSize: 18, color: '#1E293B' }}>小艺</Text></Box>
                </Box>
                <Box style={{ flexDirection: 'row', gap: 8, marginTop: 8 }}>
                    <Box style={{ background: '#FFF7E9', borderRadius: 8, padding: 10 }}><Text style={{ fontSize: 18, color: '#B45309' }}>Telegram</Text></Box>
                    <Box style={{ background: '#FFF7E9', borderRadius: 8, padding: 10 }}><Text style={{ fontSize: 18, color: '#B45309' }}>Discord</Text></Box>
                    <Box style={{ background: '#FFF7E9', borderRadius: 8, padding: 10 }}><Text style={{ fontSize: 18, color: '#B45309' }}>MQTT（IoT）</Text></Box>
                </Box>
            </Box>

            {/* 右：三行 */}
            <Box style={{ flex: 1 }}>
                <Box style={{ height: 132, borderBottomWidth: 1, borderBottomColor: '#E2E8F0', borderBottomStyle: 'solid' }}>
                    <Text style={{ fontSize: 22, fontWeight: '600', color: '#1E293B', lineHeight: 1.3, marginTop: 4 }}>扫码即接入，几分钟上线</Text>
                    <Text style={{ fontSize: 18, color: '#475569', lineHeight: 1.5, marginTop: 8 }}>
                        主流平台支持扫码绑定与机器人自助创建，IT 配置一次，全员可用。
                    </Text>
                </Box>
                <Box style={{ height: 132, borderBottomWidth: 1, borderBottomColor: '#E2E8F0', borderBottomStyle: 'solid' }}>
                    <Text style={{ fontSize: 22, fontWeight: '600', color: '#1E293B', lineHeight: 1.3, marginTop: 4 }}>群聊私聊都好用</Text>
                    <Text style={{ fontSize: 18, color: '#475569', lineHeight: 1.5, marginTop: 8 }}>
                        单聊、群聊各自成会话，上下文不串台；群里 @ 一下即可让数字同事干活。
                    </Text>
                </Box>
                <Box style={{ height: 132 }}>
                    <Text style={{ fontSize: 22, fontWeight: '600', color: '#1E293B', lineHeight: 1.3, marginTop: 4 }}>不只是应答，还能主动触达</Text>
                    <Text style={{ fontSize: 18, color: '#475569', lineHeight: 1.5, marginTop: 8 }}>
                        日报、预警、待办直接推到指定会话——该提醒的事，它先开口。
                    </Text>
                </Box>
            </Box>
        </Box>

        {/* 结论条 */}
        <Box style={{ height: 58, background: '#E8EEFB', borderRadius: 10, padding: 14, marginTop: 10, justifyContent: 'center' }}>
            <Text style={{ fontSize: 19, fontWeight: '600', color: '#1E293B', lineHeight: 1.4 }}>
                推广 AI 最大的成本是改变人的习惯——把它放进现有的协作工具里，这一步就省掉了。
            </Text>
        </Box>
    </Box>
</Slide>
