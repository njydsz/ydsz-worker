<Slide style={{ padding: 60, background: '#FFFFFF' }}>
    <Box style={{ height: 600 }}>
        <Box style={{ height: 20, flexDirection: 'row', justifyContent: 'space-between', alignItems: 'center' }}>
            <Text style={{ fontSize: 14, color: '#94A3B8', letterSpacing: 2 }}>02 · 业务怎么用</Text>
            <Box style={{ width: 44, height: 4, borderRadius: 2, background: '#2563EB' }} />
        </Box>
        <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#1E293B', marginTop: 16, lineHeight: 1.2 }}>
            部门深挖｜人力 HR：答疑不重复，招聘更省力
        </Text>
        <Box style={{ height: 1, background: '#E2E8F0', marginTop: 16 }} />

        <Box style={{ flex: 1, marginTop: 20, flexDirection: 'row', gap: 28 }}>
            {/* 左：常见问题 chip 云 */}
            <Box style={{ width: 380, background: '#F4F6FB', borderRadius: 12, padding: 20 }}>
                <Text style={{ fontSize: 22, fontWeight: '600', color: '#1E293B', lineHeight: 1.3 }}>HR 每天被问的</Text>
                <Box style={{ height: 1, background: '#E2E8F0', marginTop: 12 }} />
                <Box style={{ flexDirection: 'row', gap: 8, marginTop: 14 }}>
                    <Box style={{ background: '#E8EEFB', borderRadius: 8, padding: 9 }}><Text style={{ fontSize: 18, color: '#1E293B' }}>年假怎么算</Text></Box>
                    <Box style={{ background: '#E8EEFB', borderRadius: 8, padding: 9 }}><Text style={{ fontSize: 18, color: '#1E293B' }}>社保基数</Text></Box>
                </Box>
                <Box style={{ flexDirection: 'row', gap: 8, marginTop: 8 }}>
                    <Box style={{ background: '#E8EEFB', borderRadius: 8, padding: 9 }}><Text style={{ fontSize: 18, color: '#1E293B' }}>报销流程</Text></Box>
                    <Box style={{ background: '#E8EEFB', borderRadius: 8, padding: 9 }}><Text style={{ fontSize: 18, color: '#1E293B' }}>转正材料</Text></Box>
                </Box>
                <Box style={{ flexDirection: 'row', gap: 8, marginTop: 8 }}>
                    <Box style={{ background: '#E8EEFB', borderRadius: 8, padding: 9 }}><Text style={{ fontSize: 18, color: '#1E293B' }}>调薪政策</Text></Box>
                    <Box style={{ background: '#FFF7E9', borderRadius: 8, padding: 9 }}><Text style={{ fontSize: 18, color: '#B45309' }}>入职答疑</Text></Box>
                </Box>
                <Text style={{ fontSize: 16, color: '#64748B', lineHeight: 1.5, marginTop: 14 }}>
                    高度重复、口径敏感——最适合先交给数字助理。
                </Text>
            </Box>

            {/* 右：三行 */}
            <Box style={{ flex: 1 }}>
                <Box style={{ height: 128, borderBottomWidth: 1, borderBottomColor: '#E2E8F0', borderBottomStyle: 'solid' }}>
                    <Text style={{ fontSize: 22, fontWeight: '600', color: '#1E293B', lineHeight: 1.3, marginTop: 4 }}>政策问答，统一口径</Text>
                    <Text style={{ fontSize: 18, color: '#475569', lineHeight: 1.5, marginTop: 8 }}>
                        基于公司制度作答并附出处，不同 HR 对同一问题不再给出两种说法。
                    </Text>
                </Box>
                <Box style={{ height: 128, borderBottomWidth: 1, borderBottomColor: '#E2E8F0', borderBottomStyle: 'solid' }}>
                    <Text style={{ fontSize: 22, fontWeight: '600', color: '#1E293B', lineHeight: 1.3, marginTop: 4 }}>新人入职，有问必答</Text>
                    <Text style={{ fontSize: 18, color: '#475569', lineHeight: 1.5, marginTop: 8 }}>
                        入职引导、流程答疑、材料清单随时可问，新人少走弯路，HR 少被打断。
                    </Text>
                </Box>
                <Box style={{ height: 128 }}>
                    <Text style={{ fontSize: 22, fontWeight: '600', color: '#1E293B', lineHeight: 1.3, marginTop: 4 }}>招聘事务，先做粗活</Text>
                    <Text style={{ fontSize: 18, color: '#475569', lineHeight: 1.5, marginTop: 8 }}>
                        简历按要求初筛整理、面试安排与通知草拟、培训资料整理——粗活交出去，判断留给人。
                    </Text>
                </Box>
            </Box>
        </Box>

        {/* 结论条 */}
        <Box style={{ height: 58, background: '#E8EEFB', borderRadius: 10, padding: 14, marginTop: 12, justifyContent: 'center' }}>
            <Text style={{ fontSize: 19, fontWeight: '600', color: '#1E293B', lineHeight: 1.4 }}>
                HR 从重复答疑里解放出来，把时间还给人该做的事：谈人、育人、留人。
            </Text>
        </Box>
    </Box>
</Slide>
