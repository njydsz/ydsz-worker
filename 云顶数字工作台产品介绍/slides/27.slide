<Slide style={{ padding: 60, background: '#FFFFFF' }}>
    <Box style={{ height: 600 }}>
        <Box style={{ height: 20, flexDirection: 'row', justifyContent: 'space-between', alignItems: 'center' }}>
            <Text style={{ fontSize: 14, color: '#94A3B8', letterSpacing: 2 }}>04 · INTEGRATION</Text>
            <Box style={{ width: 44, height: 4, borderRadius: 2, background: '#2563EB' }} />
        </Box>
        <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#1E293B', marginTop: 16, lineHeight: 1.2 }}>
            员工不需要学新工具：在已经在用的聊天框里派活
        </Text>
        <Box style={{ height: 1, background: '#E2E8F0', marginTop: 16 }} />

        <Box style={{ flex: 1, marginTop: 22, flexDirection: 'row', gap: 32 }}>
            {/* 左：通道清单 */}
            <Box style={{ width: 520 }}>
                <Box style={{ background: '#F8FAFC', borderWidth: 1, borderColor: '#E2E8F0', borderStyle: 'solid', borderRadius: 12, padding: 16 }}>
                    <Text style={{ fontSize: 19, fontWeight: '600', color: '#1E293B', lineHeight: 1.3 }}>10 个 IM 通道，同一条处理管线</Text>
                    <Box style={{ flexDirection: 'row', gap: 10, marginTop: 14 }}>
                        <Box style={{ flex: 1, background: '#E8EEFB', borderRadius: 8, padding: 10, alignItems: 'center' }}>
                            <Text style={{ fontSize: 16, color: '#1E293B', lineHeight: 1.3 }}>飞书</Text>
                        </Box>
                        <Box style={{ flex: 1, background: '#E8EEFB', borderRadius: 8, padding: 10, alignItems: 'center' }}>
                            <Text style={{ fontSize: 16, color: '#1E293B', lineHeight: 1.3 }}>钉钉</Text>
                        </Box>
                        <Box style={{ flex: 1, background: '#E8EEFB', borderRadius: 8, padding: 10, alignItems: 'center' }}>
                            <Text style={{ fontSize: 16, color: '#1E293B', lineHeight: 1.3 }}>企业微信</Text>
                        </Box>
                    </Box>
                    <Box style={{ flexDirection: 'row', gap: 10, marginTop: 10 }}>
                        <Box style={{ flex: 1, background: '#FFFFFF', borderWidth: 1, borderColor: '#E2E8F0', borderStyle: 'solid', borderRadius: 8, padding: 10, alignItems: 'center' }}>
                            <Text style={{ fontSize: 16, color: '#1E293B', lineHeight: 1.3 }}>微信</Text>
                        </Box>
                        <Box style={{ flex: 1, background: '#FFFFFF', borderWidth: 1, borderColor: '#E2E8F0', borderStyle: 'solid', borderRadius: 8, padding: 10, alignItems: 'center' }}>
                            <Text style={{ fontSize: 16, color: '#1E293B', lineHeight: 1.3 }}>QQ</Text>
                        </Box>
                        <Box style={{ flex: 1, background: '#FFFFFF', borderWidth: 1, borderColor: '#E2E8F0', borderStyle: 'solid', borderRadius: 8, padding: 10, alignItems: 'center' }}>
                            <Text style={{ fontSize: 16, color: '#1E293B', lineHeight: 1.3 }}>腾讯元宝</Text>
                        </Box>
                    </Box>
                    <Box style={{ flexDirection: 'row', gap: 10, marginTop: 10 }}>
                        <Box style={{ flex: 1, background: '#FFFFFF', borderWidth: 1, borderColor: '#E2E8F0', borderStyle: 'solid', borderRadius: 8, padding: 10, alignItems: 'center' }}>
                            <Text style={{ fontSize: 16, color: '#1E293B', lineHeight: 1.3 }}>Telegram</Text>
                        </Box>
                        <Box style={{ flex: 1, background: '#FFFFFF', borderWidth: 1, borderColor: '#E2E8F0', borderStyle: 'solid', borderRadius: 8, padding: 10, alignItems: 'center' }}>
                            <Text style={{ fontSize: 16, color: '#1E293B', lineHeight: 1.3 }}>Discord</Text>
                        </Box>
                        <Box style={{ flex: 1, background: '#FFFFFF', borderWidth: 1, borderColor: '#E2E8F0', borderStyle: 'solid', borderRadius: 8, padding: 10, alignItems: 'center' }}>
                            <Text style={{ fontSize: 16, color: '#1E293B', lineHeight: 1.3 }}>小艺</Text>
                        </Box>
                    </Box>
                    <Box style={{ flexDirection: 'row', gap: 10, marginTop: 10 }}>
                        <Box style={{ flex: 1, background: '#FFF7E9', borderWidth: 1, borderColor: '#F5D9A4', borderStyle: 'solid', borderRadius: 8, padding: 10, alignItems: 'center' }}>
                            <Text style={{ fontSize: 16, color: '#1E293B', lineHeight: 1.3 }}>MQTT（IoT）</Text>
                        </Box>
                        <Box style={{ flex: 2, background: '#F4F6FB', borderRadius: 8, padding: 10, alignItems: 'center' }}>
                            <Text style={{ fontSize: 16, color: '#64748B', lineHeight: 1.3 }}>插件可扩展更多通道</Text>
                        </Box>
                    </Box>
                </Box>
            </Box>

            {/* 右：场景与机制 */}
            <Box style={{ width: 608 }}>
                <Box style={{ paddingBottom: 11, borderBottomWidth: 1, borderBottomColor: '#E2E8F0', borderBottomStyle: 'solid' }}>
                    <Text style={{ fontSize: 21, fontWeight: '600', color: '#1E293B', lineHeight: 1.3 }}>接入方式：扫码或机器人自助创建</Text>
                    <Text style={{ fontSize: 16, color: '#475569', lineHeight: 1.5, marginTop: 8 }}>
                        主流平台支持扫码绑定与机器人自助创建。
                    </Text>
                </Box>
                <Box style={{ paddingTop: 14, paddingBottom: 11, borderBottomWidth: 1, borderBottomColor: '#E2E8F0', borderBottomStyle: 'solid' }}>
                    <Text style={{ fontSize: 21, fontWeight: '600', color: '#1E293B', lineHeight: 1.3 }}>群里也能用：单聊与群聊分别成会话</Text>
                    <Text style={{ fontSize: 16, color: '#475569', lineHeight: 1.5, marginTop: 8 }}>
                        会话键按平台区分，群聊上下文不会串到私聊。
                    </Text>
                </Box>
                <Box style={{ paddingTop: 14, paddingBottom: 11, borderBottomWidth: 1, borderBottomColor: '#E2E8F0', borderBottomStyle: 'solid' }}>
                    <Text style={{ fontSize: 21, fontWeight: '600', color: '#1E293B', lineHeight: 1.3 }}>主动触达：不只是被动应答</Text>
                    <Text style={{ fontSize: 16, color: '#475569', lineHeight: 1.5, marginTop: 8 }}>
                        定时任务与主动关怀可把日报与预警推到指定会话。
                    </Text>
                </Box>
                <Box style={{ paddingTop: 11 }}>
                    <Text style={{ fontSize: 21, fontWeight: '600', color: '#1E293B', lineHeight: 1.3 }}>边界说明</Text>
                    <Text style={{ fontSize: 16, color: '#475569', lineHeight: 1.5, marginTop: 8 }}>
                        未提供 WhatsApp 与 Teams 通道；Slack 为连接器。
                    </Text>
                </Box>
            </Box>
        </Box>

        <Box style={{ marginTop: 20, flexDirection: 'row', alignItems: 'center', background: '#F4F6FB', borderRadius: 8, padding: 16, gap: 16 }}>
            <Box style={{ width: 4, height: 40, borderRadius: 2, background: '#2563EB' }} />
            <Text style={{ flex: 1, fontSize: 19, color: '#1E293B', lineHeight: 1.5 }}>
                推广 AI 最大的成本往往不是技术，而是改变人的习惯——把它放进现有的协作工具里，这一步就省掉了。
            </Text>
        </Box>
    </Box>
</Slide>
