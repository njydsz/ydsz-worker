<Slide style={{ padding: 60, background: '#FFFFFF' }}>
    <Box style={{ height: 600 }}>
        <Box style={{ height: 20, flexDirection: 'row', justifyContent: 'space-between', alignItems: 'center' }}>
            <Text style={{ fontSize: 14, color: '#94A3B8', letterSpacing: 2 }}>03 · SECURITY & GOVERNANCE</Text>
            <Box style={{ width: 44, height: 4, borderRadius: 2, background: '#2563EB' }} />
        </Box>
        <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#1E293B', marginTop: 16, lineHeight: 1.2 }}>
            出问题能回放每一步，出问题之前能提前备份
        </Text>
        <Box style={{ height: 1, background: '#E2E8F0', marginTop: 16 }} />

        <Box style={{ flex: 1, marginTop: 20 }}>
            {/* 上图：轨迹账本链路 */}
            <Box style={{ background: '#F8FAFC', borderWidth: 1, borderColor: '#E2E8F0', borderStyle: 'solid', borderRadius: 12, padding: 16 }}>
                <Text style={{ fontSize: 19, fontWeight: '600', color: '#1E293B', lineHeight: 1.3 }}>轨迹账本：每一次工具调用都留痕</Text>
                <Box style={{ flexDirection: 'row', alignItems: 'center', marginTop: 14 }}>
                    <Box style={{ width: 320, background: '#FFFFFF', borderWidth: 1, borderColor: '#C7D6F5', borderStyle: 'solid', borderRadius: 8, padding: 12 }}>
                        <Text style={{ fontSize: 16, fontWeight: '600', color: '#2563EB', lineHeight: 1.3 }}>工具调用发生</Text>
                        <Text style={{ fontSize: 14, color: '#64748B', lineHeight: 1.4 }}>读文件、跑命令、开浏览器、查知识库</Text>
                    </Box>
                    <Box style={{ width: 40, justifyContent: 'center', alignItems: 'center' }}>
                        <svg width={40} height={16} viewBox='0 0 40 16'><path d='M0 8 L28 8' stroke='#C7D6F5' strokeWidth='2' /><path d='M28 2 L40 8 L28 14 Z' fill='#C7D6F5' /></svg>
                    </Box>
                    <Box style={{ width: 320, background: '#D6E4F9', borderRadius: 8, padding: 12 }}>
                        <Text style={{ fontSize: 16, fontWeight: '600', color: '#1E293B', lineHeight: 1.3 }}>事件落库</Text>
                        <Text style={{ fontSize: 14, color: '#475569', lineHeight: 1.4 }}>调用、参数与结果写入轨迹事件表</Text>
                    </Box>
                    <Box style={{ width: 40, justifyContent: 'center', alignItems: 'center' }}>
                        <svg width={40} height={16} viewBox='0 0 40 16'><path d='M0 8 L28 8' stroke='#F59E0B' strokeWidth='2' /><path d='M28 2 L40 8 L28 14 Z' fill='#F59E0B' /></svg>
                    </Box>
                    <Box style={{ flex: 1, background: '#FFF7E9', borderWidth: 1, borderColor: '#F5D9A4', borderStyle: 'solid', borderRadius: 8, padding: 12 }}>
                        <Text style={{ fontSize: 16, fontWeight: '600', color: '#B45309', lineHeight: 1.3 }}>三种检视视图</Text>
                        <Text style={{ fontSize: 14, color: '#92400E', lineHeight: 1.4 }}>调用清单、时间轴、明细与指标条</Text>
                    </Box>
                </Box>
            </Box>

            {/* 下图：备份四点 */}
            <Box style={{ flexDirection: 'row', gap: 18, marginTop: 16 }}>
                <Box style={{ flex: 1, background: '#FFFFFF', borderWidth: 1, borderColor: '#E2E8F0', borderStyle: 'solid', borderRadius: 10, padding: 13 }}>
                    <Text style={{ fontSize: 18, fontWeight: '600', color: '#1E293B', lineHeight: 1.3 }}>自动备份可挂定时</Text>
                    <Text style={{ fontSize: 15, color: '#475569', lineHeight: 1.5, marginTop: 7 }}>
                        备份作业本身可纳入定时任务周期执行，无需额外运维脚本。
                    </Text>
                </Box>
                <Box style={{ flex: 1, background: '#FFFFFF', borderWidth: 1, borderColor: '#E2E8F0', borderStyle: 'solid', borderRadius: 10, padding: 13 }}>
                    <Text style={{ fontSize: 18, fontWeight: '600', color: '#1E293B', lineHeight: 1.3 }}>覆盖控制面与工作区</Text>
                    <Text style={{ fontSize: 15, color: '#475569', lineHeight: 1.5, marginTop: 7 }}>
                        支持数据库转储与工作区归档，PostgreSQL 场景走专用导出工具。
                    </Text>
                </Box>
                <Box style={{ flex: 1, background: '#FFFFFF', borderWidth: 1, borderColor: '#E2E8F0', borderStyle: 'solid', borderRadius: 10, padding: 13 }}>
                    <Text style={{ fontSize: 18, fontWeight: '600', color: '#1E293B', lineHeight: 1.3 }}>升级前一键导出</Text>
                    <Text style={{ fontSize: 15, color: '#475569', lineHeight: 1.5, marginTop: 7 }}>
                        跨版本升级前可先备份再更新，服务模式下自动重启恢复运行。
                    </Text>
                </Box>
                <Box style={{ flex: 1, background: '#FFFFFF', borderWidth: 1, borderColor: '#E2E8F0', borderStyle: 'solid', borderRadius: 10, padding: 13 }}>
                    <Text style={{ fontSize: 18, fontWeight: '600', color: '#1E293B', lineHeight: 1.3 }}>轨迹不只是日志</Text>
                    <Text style={{ fontSize: 15, color: '#475569', lineHeight: 1.5, marginTop: 7 }}>
                        可按会话回放完整过程，用于复盘、追责与效果度量。
                    </Text>
                </Box>
            </Box>
        </Box>

        <Box style={{ marginTop: 20, flexDirection: 'row', alignItems: 'center', background: '#F4F6FB', borderRadius: 8, padding: 16, gap: 16 }}>
            <Box style={{ width: 4, height: 40, borderRadius: 2, background: '#2563EB' }} />
            <Text style={{ flex: 1, fontSize: 19, color: '#1E293B', lineHeight: 1.5 }}>
                可回放、可恢复、可解释——这三项能力决定了 AI 能不能真正通过企业的内控与安全评审。
            </Text>
        </Box>
    </Box>
</Slide>
