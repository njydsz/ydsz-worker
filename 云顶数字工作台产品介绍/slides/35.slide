<Slide style={{ padding: 60, background: '#FFFFFF' }}>
    <Box style={{ height: 600 }}>
        <Box style={{ height: 20, flexDirection: 'row', justifyContent: 'space-between', alignItems: 'center' }}>
            <Text style={{ fontSize: 14, color: '#94A3B8', letterSpacing: 2 }}>05 · DEPLOYMENT</Text>
            <Box style={{ width: 44, height: 4, borderRadius: 2, background: '#1D4ED8' }} />
        </Box>
        <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#12275A', marginTop: 16, lineHeight: 1.2 }}>
            场景二｜研发提效：从补全代码到受控执行
        </Text>
        <Box style={{ height: 1, background: '#E2E8F0', marginTop: 16 }} />

        <Box style={{ flex: 1, marginTop: 22, flexDirection: 'row' }}>
            {/* 左：单点补全 */}
            <Box style={{ width: 500 }}>
                <Text style={{ fontSize: 22, fontWeight: '600', color: '#94A3B8', lineHeight: 1.3 }}>通用编码助手</Text>
                <Box style={{ height: 3, width: 64, borderRadius: 2, background: '#CBD5E1', marginTop: 12 }} />
                <Box style={{ flexDirection: 'row', gap: 12, alignItems: 'flex-start', marginTop: 16 }}>
                    <Box style={{ width: 8, height: 8, borderRadius: 4, background: '#CBD5E1', marginTop: 9 }} />
                    <Text style={{ flex: 1, fontSize: 17, color: '#64748B', lineHeight: 1.5 }}>
                        能力集中在编辑器内的补全与建议，跨出编辑器就断开。
                    </Text>
                </Box>
                <Box style={{ flexDirection: 'row', gap: 12, alignItems: 'flex-start', marginTop: 14 }}>
                    <Box style={{ width: 8, height: 8, borderRadius: 4, background: '#CBD5E1', marginTop: 9 }} />
                    <Text style={{ flex: 1, fontSize: 17, color: '#64748B', lineHeight: 1.5 }}>
                        跑测试、查日志、改配置要靠人手动完成，工具链割裂。
                    </Text>
                </Box>
                <Box style={{ flexDirection: 'row', gap: 12, alignItems: 'flex-start', marginTop: 14 }}>
                    <Box style={{ width: 8, height: 8, borderRadius: 4, background: '#CBD5E1', marginTop: 9 }} />
                    <Text style={{ flex: 1, fontSize: 17, color: '#64748B', lineHeight: 1.5 }}>
                        执行权限由个人机器决定，团队难以统一策略与留痕。
                    </Text>
                </Box>
                <Box style={{ marginTop: 18, background: '#F1F5F9', borderRadius: 10, padding: 14 }}>
                    <Text style={{ fontSize: 16, color: '#64748B', lineHeight: 1.5 }}>
                        结果：个人效率提升明显，但团队无法把它纳入统一的工程规范与审计。
                    </Text>
                </Box>
            </Box>

            <Box style={{ width: 1, background: '#E2E8F0', marginLeft: 28, marginRight: 28 }} />

            {/* 右：受控执行 */}
            <Box style={{ width: 602 }}>
                <Text style={{ fontSize: 22, fontWeight: '600', color: '#12275A', lineHeight: 1.3 }}>云顶数字工作台</Text>
                <Box style={{ height: 3, width: 64, borderRadius: 2, background: '#1D4ED8', marginTop: 12 }} />
                <Box style={{ flexDirection: 'row', gap: 12, marginTop: 14 }}>
                    <Box style={{ flex: 1, background: '#E8EEFB', borderWidth: 1, borderColor: '#C7D6F5', borderStyle: 'solid', borderRadius: 10, padding: 12 }}>
                        <Text style={{ fontSize: 17, fontWeight: '600', color: '#1D4ED8', lineHeight: 1.3 }}>ACP 入站</Text>
                        <Text style={{ fontSize: 14, color: '#475569', lineHeight: 1.5, marginTop: 6 }}>
                            在 IDE 与终端里直接调用本机 Agent。
                        </Text>
                    </Box>
                    <Box style={{ flex: 1, background: '#E8EEFB', borderWidth: 1, borderColor: '#C7D6F5', borderStyle: 'solid', borderRadius: 10, padding: 12 }}>
                        <Text style={{ fontSize: 17, fontWeight: '600', color: '#1D4ED8', lineHeight: 1.3 }}>ACP 出站</Text>
                        <Text style={{ fontSize: 14, color: '#475569', lineHeight: 1.5, marginTop: 6 }}>
                            复杂任务可委派给外部编程 Agent。
                        </Text>
                    </Box>
                </Box>
                <Box style={{ flexDirection: 'row', gap: 12, marginTop: 12 }}>
                    <Box style={{ flex: 1, background: '#F8FAFC', borderWidth: 1, borderColor: '#E2E8F0', borderStyle: 'solid', borderRadius: 10, padding: 12 }}>
                        <Text style={{ fontSize: 17, fontWeight: '600', color: '#12275A', lineHeight: 1.3 }}>命令守卫 + 审批</Text>
                        <Text style={{ fontSize: 14, color: '#475569', lineHeight: 1.5, marginTop: 6 }}>
                            危险命令执行前被拦截或转审批。
                        </Text>
                    </Box>
                    <Box style={{ flex: 1, background: '#F8FAFC', borderWidth: 1, borderColor: '#E2E8F0', borderStyle: 'solid', borderRadius: 10, padding: 12 }}>
                        <Text style={{ fontSize: 17, fontWeight: '600', color: '#12275A', lineHeight: 1.3 }}>轨迹留痕</Text>
                        <Text style={{ fontSize: 14, color: '#475569', lineHeight: 1.5, marginTop: 6 }}>
                            每次命令与文件改动可回放。
                        </Text>
                    </Box>
                </Box>
                <Box style={{ marginTop: 12, background: '#12275A', borderRadius: 10, padding: 14 }}>
                    <Text style={{ fontSize: 16, color: '#D6E3F5', lineHeight: 1.5 }}>
                        差别不在写得多快，而在能不能被信任地执行。
                    </Text>
                </Box>
            </Box>
        </Box>

        <Box style={{ marginTop: 20, flexDirection: 'row', alignItems: 'center', background: '#F4F6FB', borderRadius: 8, padding: 16, gap: 16 }}>
            <Box style={{ width: 4, height: 40, borderRadius: 2, background: '#1D4ED8' }} />
            <Text style={{ flex: 1, fontSize: 19, color: '#12275A', lineHeight: 1.5 }}>
                给开发者一个更聪明的输入框，不如给团队一个受管控的执行者——前者提升个人手感，后者改变交付方式。
            </Text>
        </Box>
    </Box>
</Slide>
