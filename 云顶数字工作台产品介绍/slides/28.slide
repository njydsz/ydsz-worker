<Slide style={{ padding: 60, background: '#FFFFFF' }}>
    <Box style={{ height: 600 }}>
        <Box style={{ height: 20, flexDirection: 'row', justifyContent: 'space-between', alignItems: 'center' }}>
            <Text style={{ fontSize: 14, color: '#94A3B8', letterSpacing: 2 }}>04 · INTEGRATION</Text>
            <Box style={{ width: 44, height: 4, borderRadius: 2, background: '#2563EB' }} />
        </Box>
        <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#1E293B', marginTop: 16, lineHeight: 1.2 }}>
            既是对等协作者，也是被调用的服务
        </Text>
        <Box style={{ height: 1, background: '#E2E8F0', marginTop: 16 }} />

        <Box style={{ flex: 1, marginTop: 22, flexDirection: 'row', gap: 24 }}>
            {/* 出站方向 */}
            <Box style={{ flex: 1, background: '#E6F7F9', borderWidth: 1, borderColor: '#B6E3EA', borderStyle: 'solid', borderRadius: 12, padding: 18 }}>
                <Text style={{ fontSize: 21, fontWeight: '600', color: '#0891B2', lineHeight: 1.3 }}>我们调用外部</Text>
                <Text style={{ fontSize: 15, color: '#64748B', lineHeight: 1.5, marginTop: 8 }}>
                    把任务交给更合适的工具完成
                </Text>
                <Box style={{ height: 1, background: '#B6E3EA', marginTop: 14 }} />
                <Box style={{ flexDirection: 'row', gap: 12, alignItems: 'flex-start', marginTop: 14 }}>
                    <Text style={{ fontSize: 15, fontWeight: '600', color: '#1E293B', lineHeight: 1.4, width: 76 }}>ACP 出站</Text>
                    <Text style={{ flex: 1, fontSize: 15, color: '#475569', lineHeight: 1.5 }}>
                        把编码任务委派给 OpenCode、CodeBuddy、Claude Code、Codex 等外部编程 Agent。
                    </Text>
                </Box>
                <Box style={{ flexDirection: 'row', gap: 12, alignItems: 'flex-start', marginTop: 12 }}>
                    <Text style={{ fontSize: 15, fontWeight: '600', color: '#1E293B', lineHeight: 1.4, width: 76 }}>MCP 出站</Text>
                    <Text style={{ flex: 1, fontSize: 15, color: '#475569', lineHeight: 1.5 }}>
                        作为 MCP 客户端连接外部 MCP 服务，完整支持会话协商与协议版本。
                    </Text>
                </Box>
                <Box style={{ flexDirection: 'row', gap: 12, alignItems: 'flex-start', marginTop: 12 }}>
                    <Text style={{ fontSize: 15, fontWeight: '600', color: '#1E293B', lineHeight: 1.4, width: 76 }}>权限协商</Text>
                    <Text style={{ flex: 1, fontSize: 15, color: '#475569', lineHeight: 1.5 }}>
                        外部 Agent 请求权限时回传至本平台审批链路，由同一套策略决定放行。
                    </Text>
                </Box>
            </Box>

            {/* 中枢 */}
            <Box style={{ width: 200, justifyContent: 'center', alignItems: 'center' }}>
                <Box style={{ width: 150, height: 150, borderRadius: 75, background: '#EFF6FF', borderWidth: 1, borderColor: '#2563EB', justifyContent: 'center', alignItems: 'center' }}>
                    <Text style={{ fontSize: 19, fontWeight: 'bold', color: '#1E293B', lineHeight: 1.3, textAlign: 'center' }}>云顶数字<br />工作台</Text>
                </Box>
                <Box style={{ flexDirection: 'row', gap: 10, marginTop: 14, alignItems: 'center' }}>
                    <svg width={30} height={14} viewBox='0 0 30 14'><path d='M30 7 L10 7' stroke='#F59E0B' strokeWidth='2' /><path d='M10 1 L0 7 L10 13 Z' fill='#F59E0B' /></svg>
                    <svg width={30} height={14} viewBox='0 0 30 14'><path d='M0 7 L20 7' stroke='#0891B2' strokeWidth='2' /><path d='M20 1 L30 7 L20 13 Z' fill='#0891B2' /></svg>
                </Box>
                <Text style={{ fontSize: 14, color: '#64748B', lineHeight: 1.4, marginTop: 8, textAlign: 'center' }}>双向协议</Text>
            </Box>

            {/* 入站方向 */}
            <Box style={{ flex: 1, background: '#FFF7E9', borderWidth: 1, borderColor: '#F5D9A4', borderStyle: 'solid', borderRadius: 12, padding: 18 }}>
                <Text style={{ fontSize: 21, fontWeight: '600', color: '#B45309', lineHeight: 1.3 }}>外部调用我们</Text>
                <Text style={{ fontSize: 15, color: '#64748B', lineHeight: 1.5, marginTop: 8 }}>
                    让既有工具链直接用上本平台能力
                </Text>
                <Box style={{ height: 1, background: '#F5D9A4', marginTop: 14 }} />
                <Box style={{ flexDirection: 'row', gap: 12, alignItems: 'flex-start', marginTop: 14 }}>
                    <Text style={{ fontSize: 15, fontWeight: '600', color: '#1E293B', lineHeight: 1.4, width: 76 }}>ACP 入站</Text>
                    <Text style={{ flex: 1, fontSize: 15, color: '#475569', lineHeight: 1.5 }}>
                        一条命令对外提供 stdio ACP 服务，供 Zed、OpenCode 等 IDE 与终端工具直接使用。
                    </Text>
                </Box>
                <Box style={{ flexDirection: 'row', gap: 12, alignItems: 'flex-start', marginTop: 12 }}>
                    <Text style={{ fontSize: 15, fontWeight: '600', color: '#1E293B', lineHeight: 1.4, width: 76 }}>MCP 入站</Text>
                    <Text style={{ flex: 1, fontSize: 15, color: '#475569', lineHeight: 1.5 }}>
                        把已配置的专家对外暴露为 MCP 工具，其他 Agent 可直接调用企业内的专家。
                    </Text>
                </Box>
                <Box style={{ flexDirection: 'row', gap: 12, alignItems: 'flex-start', marginTop: 12 }}>
                    <Text style={{ fontSize: 15, fontWeight: '600', color: '#1E293B', lineHeight: 1.4, width: 76 }}>开放接口</Text>
                    <Text style={{ flex: 1, fontSize: 15, color: '#475569', lineHeight: 1.5 }}>
                        55 组 REST 路由、WebSocket 与 SSE 事件流，供程序化集成。
                    </Text>
                </Box>
            </Box>
        </Box>

        <Box style={{ marginTop: 18, flexDirection: 'row', alignItems: 'center', background: '#F4F6FB', borderRadius: 8, padding: 14, gap: 16 }}>
            <Box style={{ width: 4, height: 44, borderRadius: 2, background: '#2563EB' }} />
            <Text style={{ flex: 1, fontSize: 18, color: '#1E293B', lineHeight: 1.5 }}>
                开放意味着不被绑定：企业可以把本平台接进现有工具链，也可以在更好的工具出现时把任务委派出去。
            </Text>
        </Box>
    </Box>
</Slide>
