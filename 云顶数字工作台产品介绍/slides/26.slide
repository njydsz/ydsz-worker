<Slide style={{ padding: 60, background: '#FFFFFF' }}>
    <Box style={{ height: 600 }}>
        <Box style={{ height: 20, flexDirection: 'row', justifyContent: 'space-between', alignItems: 'center' }}>
            <Text style={{ fontSize: 14, color: '#94A3B8', letterSpacing: 2 }}>04 · INTEGRATION</Text>
            <Box style={{ width: 44, height: 4, borderRadius: 2, background: '#2563EB' }} />
        </Box>
        <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#1E293B', marginTop: 16, lineHeight: 1.2 }}>
            日常在用的系统，开箱就能接
        </Text>
        <Box style={{ height: 1, background: '#E2E8F0', marginTop: 16 }} />

        <Box style={{ flex: 1, marginTop: 22, flexDirection: 'row', gap: 32 }}>
            {/* 巨型数字 */}
            <Box style={{ width: 380, background: '#D6E4F9', borderRadius: 12, padding: 22 }}>
                <Text style={{ fontSize: 96, fontWeight: 'bold', color: '#F59E0B', lineHeight: 1.05 }}>47</Text>
                <Text style={{ fontSize: 21, fontWeight: '600', color: '#1E293B', lineHeight: 1.3, marginTop: 4 }}>个企业系统连接器</Text>
                <Box style={{ height: 1, background: '#93C5FD', marginTop: 16 }} />
                <Text style={{ fontSize: 15, color: '#475569', lineHeight: 1.5, marginTop: 14 }}>
                    43 个已可用、4 个即将上线；接入模式为远程 17、网关 16、内建 13、stdio 1。
                </Text>
                <Text style={{ fontSize: 15, color: '#475569', lineHeight: 1.5, marginTop: 12 }}>
                    认证覆盖 API Key、OAuth2、个人令牌与自定义字段，授权流程内建。
                </Text>
            </Box>

            {/* 分类分布 */}
            <Box style={{ width: 748 }}>
                <Box style={{ flexDirection: 'row', gap: 12 }}>
                    <Box style={{ flex: 1, background: '#E8EEFB', borderWidth: 1, borderColor: '#C7D6F5', borderStyle: 'solid', borderRadius: 9, padding: 11 }}>
                        <Text style={{ fontSize: 16, fontWeight: '600', color: '#1E293B', lineHeight: 1.3 }}>办公文档 · 10</Text>
                        <Text style={{ fontSize: 14, color: '#64748B', lineHeight: 1.4 }}>腾讯文档 / 会议 / 微云 / 有道 / Notion</Text>
                    </Box>
                    <Box style={{ flex: 1, background: '#E8EEFB', borderWidth: 1, borderColor: '#C7D6F5', borderStyle: 'solid', borderRadius: 9, padding: 11 }}>
                        <Text style={{ fontSize: 16, fontWeight: '600', color: '#1E293B', lineHeight: 1.3 }}>知识沉淀 · 8</Text>
                        <Text style={{ fontSize: 14, color: '#64748B', lineHeight: 1.4 }}>腾讯 IMA / 乐享 / 语雀 / Obsidian</Text>
                    </Box>
                    <Box style={{ flex: 1, background: '#E8EEFB', borderWidth: 1, borderColor: '#C7D6F5', borderStyle: 'solid', borderRadius: 9, padding: 11 }}>
                        <Text style={{ fontSize: 16, fontWeight: '600', color: '#1E293B', lineHeight: 1.3 }}>效率协作 · 7</Text>
                        <Text style={{ fontSize: 14, color: '#64748B', lineHeight: 1.4 }}>邮箱 / 滴答清单 / 办公套件 / 腾讯问卷</Text>
                    </Box>
                </Box>
                <Box style={{ flexDirection: 'row', gap: 12, marginTop: 12 }}>
                    <Box style={{ flex: 1, background: '#F8FAFC', borderWidth: 1, borderColor: '#E2E8F0', borderStyle: 'solid', borderRadius: 9, padding: 11 }}>
                        <Text style={{ fontSize: 16, fontWeight: '600', color: '#1E293B', lineHeight: 1.3 }}>出行差旅 · 5</Text>
                        <Text style={{ fontSize: 14, color: '#64748B', lineHeight: 1.4 }}>飞猪 / 携程 / 美团 / 滴滴 / 百度地图</Text>
                    </Box>
                    <Box style={{ flex: 1, background: '#F8FAFC', borderWidth: 1, borderColor: '#E2E8F0', borderStyle: 'solid', borderRadius: 9, padding: 11 }}>
                        <Text style={{ fontSize: 16, fontWeight: '600', color: '#1E293B', lineHeight: 1.3 }}>媒体内容 · 4</Text>
                        <Text style={{ fontSize: 14, color: '#64748B', lineHeight: 1.4 }}>腾讯新闻 / 微信读书 / QQ 音乐 / RSS</Text>
                    </Box>
                    <Box style={{ flex: 1, background: '#F8FAFC', borderWidth: 1, borderColor: '#E2E8F0', borderStyle: 'solid', borderRadius: 9, padding: 11 }}>
                        <Text style={{ fontSize: 16, fontWeight: '600', color: '#1E293B', lineHeight: 1.3 }}>研发与项目 · 4</Text>
                        <Text style={{ fontSize: 14, color: '#64748B', lineHeight: 1.4 }}>GitHub / Jira / Linear / TAPD</Text>
                    </Box>
                </Box>
                <Box style={{ flexDirection: 'row', gap: 12, marginTop: 12 }}>
                    <Box style={{ flex: 1, background: '#FFF7E9', borderWidth: 1, borderColor: '#F5D9A4', borderStyle: 'solid', borderRadius: 9, padding: 11 }}>
                        <Text style={{ fontSize: 16, fontWeight: '600', color: '#1E293B', lineHeight: 1.3 }}>专业数据 · 5</Text>
                        <Text style={{ fontSize: 14, color: '#64748B', lineHeight: 1.4 }}>企查查 / 天眼查 / 元典 / 法规 / 金融数据</Text>
                    </Box>
                    <Box style={{ flex: 2, background: '#F4F6FB', borderWidth: 1, borderColor: '#E2E8F0', borderStyle: 'solid', borderRadius: 9, padding: 11 }}>
                        <Text style={{ fontSize: 16, fontWeight: '600', color: '#1E293B', lineHeight: 1.3 }}>自定义 MCP 与内部系统</Text>
                        <Text style={{ fontSize: 14, color: '#64748B', lineHeight: 1.4 }}>支持按 MCP 协议登记企业自有服务，内部系统也能成为 Agent 的工具</Text>
                    </Box>
                </Box>
                <Text style={{ fontSize: 16, color: '#475569', lineHeight: 1.5, marginTop: 16 }}>
                    连接器按 Agent 绑定：客服 Agent 接工单与知识库，研发 Agent 接仓库与项目工具，权限边界随角色走。
                </Text>
            </Box>
        </Box>

        <Box style={{ marginTop: 20, flexDirection: 'row', alignItems: 'center', background: '#F4F6FB', borderRadius: 8, padding: 16, gap: 16 }}>
            <Box style={{ width: 4, height: 40, borderRadius: 2, background: '#2563EB' }} />
            <Text style={{ flex: 1, fontSize: 19, color: '#1E293B', lineHeight: 1.5 }}>
                主流办公与业务系统的接入已无需自研——省下的不是几个接口的工作量，而是整套授权、刷新与运维的长期成本。
            </Text>
        </Box>
    </Box>
</Slide>
